BUSINESS_NAME=Eazy Diagnostics
BOOKING_PHONE=+91 70197 64500
SUPPORT_EMAIL=care@example.com
OWNER_EMAIL=owner@example.com
FROM_EMAIL=bookings@example.com
SITE_URL=https://example.com

# Optional: leave unset to run checkout in test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: leave unset to only log emails to the dev inbox at /admin/inbox
RESEND_API_KEY=

# Doctor sign-ups (/for-doctors) are recorded in a Google Sheet through a small Apps Script.
# Setup steps are in scripts/google-apps-script/doctor-signups.gs. Leave both unset locally to
# save sign-ups to .data/doctor-signups.json instead (in production they are required).
DOCTOR_SHEET_WEBHOOK_URL=
DOCTOR_SHEET_WEBHOOK_SECRET=

# Protects the /admin pages (doctors list, dev inbox) with a browser login. Required in
# production (admin is locked without it); leave unset locally to keep /admin open.
ADMIN_PASSWORD=
ADMIN_USER=admin
