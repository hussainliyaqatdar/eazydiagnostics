BUSINESS_NAME=Eazy Diagnostics
BOOKING_PHONE=+91 70197 64500
SUPPORT_EMAIL=care@example.com
OWNER_EMAIL=owner@example.com
FROM_EMAIL=bookings@example.com
SITE_URL=https://example.com

# Optional: leave unset to run checkout in test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: leave unset to only log emails to the dev inbox at /admin/inbox
RESEND_API_KEY=

# WhatsApp order updates (Meta WhatsApp Cloud API). Leave unset and status changes on /admin/orders
# still save but no messages are sent. Setup steps and the two templates to approve: docs/whatsapp-setup.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Needed to create / sync / delete templates from /admin/whatsapp:
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Webhook (delivery status + template approvals) at <SITE_URL>/api/whatsapp/webhook:
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Only if you named the generic update templates differently:
# WHATSAPP_PATIENT_TEMPLATE=order_status_patient
# WHATSAPP_DOCTOR_TEMPLATE=order_status_doctor
# WHATSAPP_TEMPLATE_LANGUAGE=en

# Postgres database for doctors and orders. On Render: create a PostgreSQL database, then paste
# its "Internal Database URL" here (service Environment tab). Required in production.
# Leave unset locally: development uses an embedded Postgres in .data/pgdata.
DATABASE_URL=

# Protects the /admin pages (doctors list, dev inbox) with a browser login. Required in
# production to turn the login on. While unset, /admin is open to anyone with the URL.
ADMIN_PASSWORD=
ADMIN_USER=admin

# Google Search Console: add your site as a "URL prefix" property, choose the "HTML tag" method, and paste
# just the content="..." token here. Then use "Verify" in Search Console and submit /sitemap.xml.
GOOGLE_SITE_VERIFICATION=
